<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds a block to the Employees settings; nothing existing is changed -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.shift.planning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='work_organization_setting_container']" position="after">
                <block title="Shift Planning" name="shift_planning_setting_container">
                    <setting id="shift_planning_limits"
                             string="Labour Code Warnings"
                             help="The planning grid warns (without blocking) when a plan goes beyond these limits.">
                        <div class="content-group mt-2">
                            <div class="row">
                                <label for="shift_min_rest_hours" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6">
                                    <field name="shift_min_rest_hours" widget="float_time" class="w-50"/> h
                                </div>
                            </div>
                            <div class="row">
                                <label for="shift_max_shift_hours" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6">
                                    <field name="shift_max_shift_hours" widget="float_time" class="w-50"/> h
                                </div>
                            </div>
                            <div class="row">
                                <label for="shift_max_week_hours" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6">
                                    <field name="shift_max_week_hours" class="w-50"/> h
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
