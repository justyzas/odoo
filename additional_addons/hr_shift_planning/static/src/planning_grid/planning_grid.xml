<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_shift_planning.ShiftPlanningGrid">
        <div class="o_action o_shift_planning">
            <Layout display="{ controlPanel: {} }">
                <t t-set-slot="control-panel-create-button">
                    <div class="d-flex gap-1">
                        <t t-if="state.grid.canEdit">
                            <button class="btn btn-primary o_shift_save" t-att-disabled="!hasChanges or state.saving" t-on-click="save">
                                Save<t t-if="hasChanges"> (<t t-esc="changeCount"/>)</t>
                            </button>
                            <button class="btn btn-secondary o_shift_discard" t-att-disabled="!hasChanges or state.saving" t-on-click="discard">
                                Discard
                            </button>
                        </t>
                        <t t-set="warningCount" t-value="computeWarnings().issues.length"/>
                        <button t-if="warningCount" class="btn btn-warning o_shift_warnings_btn"
                                title="Labour code warnings" t-on-click="openWarnings">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="warningCount"/>
                        </button>
                    </div>
                </t>
                <t t-set-slot="layout-actions">
                    <div t-if="state.grid.canEdit" class="o_shift_toolbar d-flex flex-wrap align-items-center gap-1">
                        <button t-foreach="state.grid.palette" t-as="template" t-key="template.id"
                                class="btn o_shift_brush"
                                t-att-class="{ o_shift_brush_active: isBrushActive(template.id) }"
                                t-att-style="template.style"
                                t-att-data-template-id="template.id"
                                t-att-title="template.name + ' ' + template.timeLabel"
                                t-on-click="() => this.selectBrush(template.id)">
                            <t t-esc="template.code"/>
                        </button>
                        <button class="btn btn-light o_shift_brush o_shift_brush_clear"
                                t-att-class="{ o_shift_brush_active: isBrushActive(false) }"
                                title="Clear"
                                t-on-click="() => this.selectBrush(false)">
                            <i class="fa fa-eraser"/> Clear
                        </button>
                        <span t-if="!state.grid.palette.length" class="text-muted small ms-1">
                            No shift templates yet: create them in Working Hours → Templates.
                        </span>
                    </div>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <div class="d-flex align-items-center gap-1">
                        <span class="o_shift_month me-2 fw-bold text-capitalize text-nowrap" t-esc="monthLabel"/>
                        <button class="btn btn-secondary o_shift_prev" title="Previous month" t-on-click="() => this.changeMonth(-1)">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button class="btn btn-secondary o_shift_today_btn" t-on-click="goToday">Today</button>
                        <button class="btn btn-secondary o_shift_next" title="Next month" t-on-click="() => this.changeMonth(1)">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                </t>

                <t t-set="warnings" t-value="computeWarnings()"/>
                <div t-if="!state.grid.employees.length" class="o_view_nocontent">
                    <div class="o_nocontent_help">
                        <p class="o_view_nocontent_empty_folder">No employees</p>
                    </div>
                </div>
                <table t-else="" class="o_shift_grid"
                       t-on-click="onGridClick"
                       t-on-mouseover="onGridMouseOver"
                       t-on-mouseleave="onGridMouseLeave">
                    <thead>
                        <tr>
                            <th class="o_shift_corner">
                                <input type="search" class="form-control form-control-sm o_shift_search mb-1"
                                       placeholder="Search employee..."
                                       t-att-value="state.search" t-on-input="onSearchInput"/>
                                <select t-if="state.grid.departments.length" class="form-select form-select-sm o_shift_department"
                                        t-on-change="onDepartmentChange">
                                    <option value="" t-att-selected="!state.department">All departments</option>
                                    <option t-foreach="state.grid.departments" t-as="department" t-key="department"
                                            t-att-value="department" t-att-selected="department === state.department"
                                            t-esc="department"/>
                                </select>
                            </th>
                            <t t-foreach="state.grid.days" t-as="day" t-key="day.key">
                                <th class="o_shift_day_header" t-att-class="getDayClass(day)"
                                    t-att-data-day="day.key" t-att-title="day.holiday">
                                    <div class="o_shift_day_number" t-esc="day.day"/>
                                    <div class="o_shift_weekday" t-esc="day.weekday"/>
                                </th>
                            </t>
                            <th class="o_shift_total_header" title="Planned hours this month">Σ h</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="visibleEmployees" t-as="employee" t-key="employee.id">
                            <th class="o_shift_employee" t-att-class="{ o_shift_selected_employee: isEmployeeSelected(employee) }">
                                <div class="o_shift_employee_name text-truncate" t-esc="employee.name"/>
                                <div t-if="employee.info" class="o_shift_employee_info text-truncate" t-esc="employee.info"/>
                            </th>
                            <t t-foreach="state.grid.days" t-as="day" t-key="day.key">
                                <t t-set="cell" t-value="getCell(employee, day, warnings)"/>
                                <td class="o_shift_cell" t-att-class="getCellClass(employee, day, cell)"
                                    t-att-data-day="day.key" t-att-data-employee-id="employee.id"
                                    t-att-title="cell.title">
                                    <div t-if="cell.shift" class="o_shift_chip" t-att-style="cell.shift.style">
                                        <span class="o_shift_code" t-esc="cell.shift.label"/>
                                        <span class="o_shift_hours" t-esc="cell.shift.hours"/>
                                    </div>
                                </td>
                            </t>
                            <td class="o_shift_total" t-esc="getEmployeeTotal(employee)"/>
                        </tr>
                    </tbody>
                </table>
            </Layout>
        </div>
    </t>

</templates>
