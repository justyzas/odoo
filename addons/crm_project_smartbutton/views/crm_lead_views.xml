<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_project" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.project</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="project_count" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_projects"
                      type="object"
                      class="oe_stat_button"
                      icon="fa-puzzle-piece"
                      invisible="project_count == 0">
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
